# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=briefcase

# Role-Based Connection Pools (Least Privilege)
DB_ADMIN_USER=briefcase_app
DB_ADMIN_PASSWORD=your_admin_pool_password

DB_LAWYER_USER=briefcase_lawyer
DB_LAWYER_PASSWORD=your_lawyer_pool_password

DB_STAFF_USER=briefcase_staff
DB_STAFF_PASSWORD=your_staff_pool_password

DB_AUTH_USER=briefcase_auth
DB_AUTH_PASSWORD=your_auth_pool_password

# =====================================================================
# MIGRATIONS ONLY (Never read by runtime application code)
# =====================================================================
# DB_MIGRATION_USER=root
# DB_MIGRATION_PASSWORD=your_mysql_root_password

# Application Server
PORT=5000
NODE_ENV=development

# JWT Secret for Authenticated Operations (Required - server fails fast if missing)
JWT_SECRET=briefcase_svnit_secret_key_2026_dbms_project
